#!/usr/bin/env bash
# ForgeOS — chuleta de atajos en rofi (Alt+Shift+A)
# Muestra los atajos de i3 que más se usan. Elegir una línea solo cierra
# la ventana: es una chuleta para mirar, no un menú de acciones.
# Uso: forgeos-atajos (desde i3 con Alt+Shift+A)
set -euo pipefail

if ! command -v rofi >/dev/null 2>&1; then
  echo "forgeos-atajos: rofi no instalado" >&2
  exit 1
fi

printf '%s\n' \
  "Alt+Return — Nueva terminal" \
  "Alt+T — 4 terminales en mosaico (espacio 2)" \
  "Alt+M — Ir al monitor (espacio 1)" \
  "Alt+Shift+M — Reabrir el monitor" \
  "Alt+Shift+N — Menú ForgeOS" \
  "Alt+D — Lanzador rofi" \
  "Alt+Shift+D — Ejecutar comando (rofi run)" \
  "Alt+I — InfoForge interactivo" \
  "Alt+O — Datos del sistema" \
  "Alt+Shift+B — Bienvenida" \
  "Alt+Shift+P — Captura completa" \
  "Alt+Control+L — Bloquear pantalla" \
  "Alt+Shift+E — Salir de i3" \
  "Alt+Shift+Q — Cerrar ventana" \
  "Alt+1…0 — Espacios de trabajo 1-10" \
  "Alt+H/J/K/L — Moverse entre ventanas" \
  "Alt+Shift+H/J/K/L — Mover ventana" \
  "Alt+F — Pantalla completa" \
  | rofi -dmenu -i -p "Atajos ForgeOS" 2>/dev/null || true
exit 0
